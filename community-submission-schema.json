{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Termix-SSH/Termix-Registry/community-submission-schema.json",
  "title": "Termix community plugin submission",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "repository", "maintainers", "versions"],
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "description": "The plugin id from manifest.json. The file name must be <id>.json.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "maxLength": 64
    },
    "repository": {
      "description": "The public GitHub repo the plugin is built and released from.",
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9-]+/[A-Za-z0-9._-]+$"
    },
    "maintainers": {
      "description": "GitHub usernames allowed to open PRs that change this file.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$"
      }
    },
    "versions": {
      "description": "Reviewed releases, newest first. Each is the v<version> GitHub release of the repo.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "sha256"],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$"
          },
          "sha256": {
            "description": "sha256 of <id>-<version>.tmxplug, from the release job summary.",
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
