{
  "name": "termix-registry",
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "validate:offline": "node scripts/validate.mjs --offline",
    "sync": "node scripts/sync.mjs",
    "check:submission": "node scripts/check-submission.mjs",
    "stats": "node scripts/stats.mjs",
    "test": "node --test \"translate/*.test.mjs\" \"tests/**/*.test.mjs\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || true",
    "check:workflows": "node scripts/check-workflows.mjs",
    "trust:check": "node scripts/trust/check.mjs",
    "trust:sign": "node scripts/trust/sign.mjs",
    "trust:revoke": "node scripts/trust/revoke.mjs",
    "trust:new-key": "node scripts/trust/make-online-key.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "yaml": "^2.9.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,css,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "semver": "^7.8.6"
  }
}
